rules_version = '2';
// =========================================================
//  ISCR Labs — solo los usuarios listados en la colección
//  "admins" (documento con el UID del usuario) pueden leer
//  o escribir. Nadie más ve nada.
//  Pegar en: Firebase → Firestore Database → Reglas → Publicar
// =========================================================
service cloud.firestore {
  match /databases/{database}/documents {
    function esAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // la lista de admins solo se edita desde la consola de Firebase
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /{coleccion}/{id} {
      allow read, write: if esAdmin() && coleccion != "admins";
    }
  }
}
